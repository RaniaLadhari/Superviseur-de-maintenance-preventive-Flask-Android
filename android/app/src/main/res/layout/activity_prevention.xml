<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- ===================================================== -->
    <!-- CONTENU PRINCIPAL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1117">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="30dp">

                <!-- ================= HEADER ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- BOUTON MENU -->

                    <TextView
                        android:id="@+id/btnMenu"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="☰"
                        android:textColor="#F2F4F7"
                        android:textSize="24sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- TITRE -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COFAT "
                                android:textColor="#F2F4F7"
                                android:textSize="21sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sense"
                                android:textColor="#FF8A00"
                                android:textSize="21sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="MAINTENANCE — PRÉVENTION (TCE)"
                            android:textColor="#7E8999"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <!-- INDICATEUR -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="#39E58C"
                        android:textSize="18sp"/>

                </LinearLayout>


                <!-- ================= ESPACE ================= -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="25dp"/>


                <!-- ================= EN-TÊTES ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="MACHINE"
                        android:textColor="#8D98A9"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="STATUT"
                        android:textColor="#8D98A9"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#29313C"/>


                <!-- ================================================= -->
                <!-- MACHINE 404 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="TCE-02"
                        android:textColor="#F1F3F5"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Aucun comptage actif"
                        android:textColor="#8792A3"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/seuil404"
                        android:layout_width="75dp"
                        android:layout_height="40dp"
                        android:background="#0D1117"
                        android:paddingStart="10dp"
                        android:paddingEnd="5dp"
                        android:text="50"
                        android:textColor="#F1F3F5"
                        android:textSize="14sp"
                        android:inputType="number"/>

                    <Button
                        android:id="@+id/btnDemarrer404"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="7dp"
                        android:text="Démarrer"
                        android:textAllCaps="false"
                        android:textColor="#11151B"
                        android:textStyle="bold"
                        android:backgroundTint="#FF851B"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnChecklist404"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="-12dp"
                    android:padding="8dp"
                    android:text="Checklist →"
                    android:textColor="#FF851B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#29313C"/>


                <!-- ================================================= -->
                <!-- MACHINE 590 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="TCE-01"
                        android:textColor="#F1F3F5"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Aucun comptage actif"
                        android:textColor="#8792A3"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/seuil590"
                        android:layout_width="75dp"
                        android:layout_height="40dp"
                        android:background="#0D1117"
                        android:paddingStart="10dp"
                        android:paddingEnd="5dp"
                        android:text="50"
                        android:textColor="#F1F3F5"
                        android:textSize="14sp"
                        android:inputType="number"/>

                    <Button
                        android:id="@+id/btnDemarrer590"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="7dp"
                        android:text="Démarrer"
                        android:textAllCaps="false"
                        android:textColor="#11151B"
                        android:textStyle="bold"
                        android:backgroundTint="#FF851B"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnChecklist590"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="-12dp"
                    android:padding="8dp"
                    android:text="Checklist →"
                    android:textColor="#FF851B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#29313C"/>


                <!-- ================================================= -->
                <!-- HETOS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="TCE-HIST"
                        android:textColor="#F1F3F5"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Aucun comptage actif"
                        android:textColor="#8792A3"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/seuilHetos"
                        android:layout_width="75dp"
                        android:layout_height="40dp"
                        android:background="#0D1117"
                        android:paddingStart="10dp"
                        android:paddingEnd="5dp"
                        android:text="50"
                        android:textColor="#F1F3F5"
                        android:textSize="14sp"
                        android:inputType="number"/>

                    <Button
                        android:id="@+id/btnDemarrerHetos"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="7dp"
                        android:text="Démarrer"
                        android:textAllCaps="false"
                        android:textColor="#11151B"
                        android:textStyle="bold"
                        android:backgroundTint="#FF851B"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnChecklistHetos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="-12dp"
                    android:padding="8dp"
                    android:text="Checklist →"
                    android:textColor="#FF851B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#29313C"/>


                <!-- ================================================= -->
                <!-- LIENS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/backErrors"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="← Erreurs machine"
                        android:textColor="#8D98A9"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/goInterventions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Historique interventions →"
                        android:textColor="#FF851B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MENU LATERAL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#19212C"
        android:padding="20dp">

        <!-- LOGO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COFAT"
                android:textColor="#F2F2F2"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sense"
                android:textColor="#FF841B"
                android:textSize="21sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- NAVIGATION -->

        <TextView
            android:id="@+id/navProduction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Production"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navErrors"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Erreurs machine"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navPrevention"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Prévention (TCE)"
            android:textColor="#FF841B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navInterventions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Historique interventions"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navHealth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Health Score"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navCopilot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Copilot IA"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>




        <!-- ESPACE -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>


        <!-- SEPARATEUR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3442"/>


        <!-- UTILISATEUR -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Karim Mansour"
            android:textColor="#A7B0BE"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="responsable"
            android:textColor="#8994A5"
            android:textSize="11sp"/>


        <!-- DECONNEXION -->

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Déconnexion"
            android:textColor="#FF4B5C"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>