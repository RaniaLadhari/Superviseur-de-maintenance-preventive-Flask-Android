<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- ===================================================== -->
    <!-- CONTENU PRINCIPAL                                     -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1117">

        <!-- BARRE DU HAUT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#111720">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#F2F2F2"
                android:textSize="25sp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COFAT Sense"
                    android:textColor="#F2F2F2"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HISTORIQUE DES INTERVENTIONS"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- CONTENU -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/interventionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"/>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MENU LATERAL                                         -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#18212D"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">


        <!-- ================================================= -->
        <!-- LOGO                                              -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COFAT"
                android:textColor="#F2F2F2"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sense"
                android:textColor="#FF7A00"
                android:textSize="19sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PRODUCTION                                        -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navProduction"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Production"
            android:textColor="#A7B0BC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ================================================= -->
        <!-- ERREURS                                           -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navErrors"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Erreurs machine"
            android:textColor="#A7B0BC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ================================================= -->
        <!-- PREVENTION                                        -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navPrevention"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Prévention (TCE)"
            android:textColor="#A7B0BC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ================================================= -->
        <!-- HISTORIQUE INTERVENTIONS                          -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navInterventions"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Historique interventions"
            android:textColor="#FF7A00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ================================================= -->
        <!-- HEALTH SCORE                                      -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navHealth"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Health Score"
            android:textColor="#A7B0BC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ================================================= -->
        <!-- COPILOT IA                                        -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/navCopilot"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Copilot IA"
            android:textColor="#A7B0BC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>


        <!-- ESPACE -->

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>


        <!-- LIGNE SEPARATION -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#293442"/>


        <!-- UTILISATEUR -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="0dp"
            android:text="Karim Mansour&#10;responsable"
            android:textColor="#A7B0BC"
            android:textSize="11sp"/>


        <!-- DECONNEXION -->

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:paddingStart="0dp"
            android:text="Déconnexion"
            android:textColor="#FF4D5A"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>