<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- ===================================================== -->
    <!-- CONTENU PRINCIPAL                                     -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1117">

        <!-- ================================================= -->
        <!-- BARRE DU HAUT                                     -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#111720">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#F2F2F2"
                android:textSize="25sp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COFAT Sense"
                    android:textColor="#F2F2F2"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUIVI COMPTEUR DES POSTES TCE"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CONTENU HEALTH                                    -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="25dp">

                <!-- ================================================= -->
                <!-- CARTE HEALTH                                      -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:background="#19232F">

                    <!-- ================================================= -->
                    <!-- TITRE                                             -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="COFAT"
                                    android:textColor="#F2F2F2"
                                    android:textSize="24sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" Sense"
                                    android:textColor="#FF7A00"
                                    android:textSize="24sp"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="SUIVI COMPTEUR DES POSTES TCE"
                                android:textColor="#8893A2"
                                android:textSize="14sp"
                                android:letterSpacing="0.15"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:background="#32D583"/>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- EN-TÊTES                                          -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="30dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="MACHINE"
                            android:textColor="#87919E"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="COMPTEUR"
                            android:textColor="#87919E"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ERREURS (30J)"
                            android:textColor="#87919E"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="DERNIÈRE PRÉV."
                            android:textColor="#87919E"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ETAT"
                            android:textColor="#87919E"
                            android:textSize="13sp"/>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- TCE-HIST                                      -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="TCE-HIST"
                            android:textColor="#E5E7EB"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtHetosScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="85"
                            android:textColor="#32D583"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtHetosErrors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtHetosPrev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Jamais"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtHetosTrend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="→ Stable"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- TCE-01                                          -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="TCE-01"
                            android:textColor="#E5E7EB"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt590Score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="99"
                            android:textColor="#32D583"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txt590Errors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt590Prev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Il y a 14j"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt590Trend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="→ Stable"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- TCE-02                                          -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="TCE-02"
                            android:textColor="#E5E7EB"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt404Score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="100"
                            android:textColor="#32D583"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txt404Errors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt404Prev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Il y a 4j"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txt404Trend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="→ Stable"
                            android:textColor="#A7B0BC"
                            android:textSize="14sp"/>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- SEPARATION                                        -->
                    <!-- ================================================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="#2B3542"/>


                    <!-- ================================================= -->
                    <!-- RETOUR                                             -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:text="← Dashboard Production"
                        android:textColor="#8994A3"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MENU LATERAL                                         -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#19212C"
        android:padding="20dp">

        <!-- LOGO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COFAT"
                android:textColor="#F2F2F2"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sense"
                android:textColor="#FF841B"
                android:textSize="21sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- NAVIGATION -->

        <TextView
            android:id="@+id/navProduction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Production"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navErrors"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Erreurs machine"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navPrevention"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Prévention (TCE)"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navInterventions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Historique interventions"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navHealth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Health Score"
            android:textColor="#FF841B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navCopilot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Copilot IA"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- ESPACE -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>


        <!-- SEPARATEUR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3442"/>


        <!-- UTILISATEUR -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Karim Mansour"
            android:textColor="#A7B0BE"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="responsable"
            android:textColor="#8994A5"
            android:textSize="11sp"/>


        <!-- DECONNEXION -->

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Déconnexion"
            android:textColor="#FF4B5C"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
