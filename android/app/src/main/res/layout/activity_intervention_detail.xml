<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1319">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- RETOUR -->

        <TextView
            android:id="@+id/btnRetour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Retour"
            android:textColor="#FF8A1E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"/>


        <!-- LOGO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COFAT"
                android:textColor="#F2F4F7"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sense"
                android:textColor="#FF8A1E"
                android:textSize="26sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- TITRE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DÉTAIL DE L'INTERVENTION"
            android:textColor="#8A94A3"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"/>


        <!-- CARTE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#1A212B"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERVENTION"
                android:textColor="#8A94A3"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/detailType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Prévention"
                android:textColor="#FF8A1E"
                android:textSize="22sp"
                android:textStyle="bold"/>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#2B3543"/>


            <!-- DATE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="DATE"
                android:textColor="#8A94A3"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/detailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="11/08/2026 20:33"
                android:textColor="#E9EDF2"
                android:textSize="16sp"/>


            <!-- MACHINE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="MACHINE"
                android:textColor="#8A94A3"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/detailMachine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="TCE-02"
                android:textColor="#E9EDF2"
                android:textSize="16sp"/>


            <!-- TECHNICIEN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TECHNICIEN"
                android:textColor="#8A94A3"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/detailTechnicien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Karim Mansour"
                android:textColor="#E9EDF2"
                android:textSize="16sp"/>


            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="DESCRIPTION"
                android:textColor="#8A94A3"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Intervention préventive réalisée sur la machine."
                android:textColor="#E9EDF2"
                android:textSize="15sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>