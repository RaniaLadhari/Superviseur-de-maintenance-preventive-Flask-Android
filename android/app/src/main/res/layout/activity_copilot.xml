<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- ===================================================== -->
    <!-- CONTENU PRINCIPAL                                     -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1117">

        <!-- ================================================= -->
        <!-- BARRE DU HAUT                                    -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#111720">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#F2F2F2"
                android:textSize="25sp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COFAT Sense"
                    android:textColor="#F2F2F2"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COPILOT IA — PRIORISATION &amp; ANALYSE"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CONTENU COPILOT                                  -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- PRIORISATION -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PRIORISATION DES INTERVENTIONS"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:id="@+id/priorityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>


                <!-- RISQUE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="ESTIMATION DE RISQUE DE PANNE"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:id="@+id/riskContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>


                <!-- COMPOSANTS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="COMPOSANTS LES PLUS EN CAUSE (GLOBAL)"
                    android:textColor="#8994A5"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:id="@+id/componentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MENU LATERAL                                         -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#19212C"
        android:padding="20dp">

        <!-- LOGO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COFAT"
                android:textColor="#F2F2F2"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sense"
                android:textColor="#FF841B"
                android:textSize="21sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- NAVIGATION -->

        <TextView
            android:id="@+id/navProduction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Production"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navErrors"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Erreurs machine"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navPrevention"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Prévention (TCE)"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navInterventions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Historique interventions"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navHealth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Health Score"
            android:textColor="#A7B0BE"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navCopilot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Copilot IA"
            android:textColor="#FF841B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <!-- ESPACE -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>


        <!-- SEPARATEUR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3442"/>


        <!-- UTILISATEUR -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Karim Mansour"
            android:textColor="#A7B0BE"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="responsable"
            android:textColor="#8994A5"
            android:textSize="11sp"/>


        <!-- DECONNEXION -->

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Déconnexion"
            android:textColor="#FF4B5C"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
